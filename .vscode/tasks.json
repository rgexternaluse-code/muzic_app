{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Build web",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": []
    },
    {
      "label": "Capacitor: sync android",
      "type": "shell",
      "command": "npx cap sync android",
      "problemMatcher": []
    },
    {
      "label": "Android: Assemble Debug",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "options": { "cwd": "${workspaceFolder}/android" },
      "problemMatcher": []
    },
    {
      "label": "Android: Assemble Release",
      "type": "shell",
      "command": "./gradlew assembleRelease",
      "options": { "cwd": "${workspaceFolder}/android" },
      "problemMatcher": []
    }
  ]
}
