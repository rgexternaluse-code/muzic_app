rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'tier', 'createdAt']) &&
        data.keys().hasOnly(['email', 'displayName', 'photoURL', 'tier', 'createdAt', 'updatedAt']) &&
        data.email is string && data.email.size() <= 254 &&
        data.tier in ['free', 'pro', 'studio_pass'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidStudioQuota(data, userId) {
      return data.keys().hasAll(['userId', 'month', 'usedUploads']) &&
        data.keys().hasOnly(['userId', 'month', 'usedUploads', 'updatedAt']) &&
        data.userId == userId &&
        data.month is string && data.month.size() <= 16 && data.month.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.usedUploads is number && data.usedUploads >= 0 && data.usedUploads <= 1000 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User profile matching
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'tier', 'updatedAt']);
      allow delete: if false;

      // Studio monthly upload quota subcollection
      match /quota/{month} {
        allow get: if isValidId(userId) && isValidId(month) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(month) && isOwner(userId) && isValidStudioQuota(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(month) && isOwner(userId) && isValidStudioQuota(incoming(), userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['usedUploads', 'updatedAt']);
        allow delete: if false;
      }
    }
  }
}
